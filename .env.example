# ========================================================
# Truth Layer: Automated Fact-Checking Agent Environment
# ========================================================

# Google Gemini API Key (Recommended for Google Search Grounding)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Alternate Google API Key variable name
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Tavily Search API Key (for external LLM search fallback)
# Get a key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Streamlit Local Deployment Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
